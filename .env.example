# Copy to .env (local) or add as environment variables on Netlify / Vercel / your host.
# NEVER commit real values. .env is git-ignored.

# REQUIRED for any broker feature — your private access code (12+ chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_ACCESS_TOKEN=

# Public https URL of your deployment (used to return you here after connecting a broker)
APP_URL=

# --- SnapTrade: Schwab, Fidelity, Robinhood, Webull, E*TRADE, Vanguard, IBKR, Coinbase, Kraken, … ---
# Get keys at https://dashboard.snaptrade.com
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Only for COMMERCIAL keys — create with:  npm run setup:snaptrade
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=

# --- Alpaca: use a READ-ONLY style setup; keys from https://app.alpaca.markets ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Show a sample portfolio (for testing the UI without a broker)
BROKER_DEMO=0

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0

# ================= ALERT BOT =================
# Run inside the Node server on a schedule (always-on hosts). Or use GitHub Actions / `npm run bot:loop`.
BOT_ENABLED=0
BOT_INTERVAL_MIN=60
# Optional overrides (otherwise bot.config.json): comma-separated symbols, sizing, filters
BOT_SYMBOLS=
BOT_ACCOUNT=10000
BOT_RISK_PCT=1
BOT_MAX_RISK=7
BOT_CRYPTO_MAX_RISK=9
BOT_CRYPTO_RISK_PCT=0.5
BOT_MIN_EVIDENCE=2
# Scan stocks even outside US market hours (1) — default only 9:45–16:20 ET on weekdays
BOT_STOCKS_ALWAYS=0
# Synthetic market data for offline testing only
MARKET_DEMO=0

# --- Where alerts go (any combination) ---
# Telegram: message @BotFather → /newbot → token; then message your bot and get chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ntfy: install the ntfy app, subscribe to a long random topic name, put the same name here
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_WEBHOOK_URL=

# --- Bot memory (serverless hosts need this; file is used otherwise) ---
BOT_STATE_FILE=./data/bot-state.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ================= LIVE TRADES (read-only) =================
# Starts automatically on a long-running Node host when a broker + APP_ACCESS_TOKEN are set.
LIVE_ENABLED=1
# Push a "FILLED" alert (with TradeGuide's signal check) to your notify channels on every fill (0 = off)
LIVE_NOTIFY=1
# SnapTrade recentOrders poll (minutes). SnapTrade asks for <= 1 poll / 10 min / account. Webhooks are faster.
SNAPTRADE_POLL_MIN=10
# Webhook URL to paste in the SnapTrade dashboard (Webhooks tab): https://YOUR-APP/api/webhooks/snaptrade
# Enable "Trade detection" add-on per account in dashboard.snaptrade.com/add-ons for seconds-level fills.

# --- Coinbase Advanced Trade (direct, real-time WebSocket). CDP key with "view" permission only ---
# Create at https://portal.cdp.coinbase.com → API keys. Paste the key name and private key (keep \n line breaks).
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# --- Robinhood Crypto Trading API (official; crypto only). robinhood.com/account/crypto → Add key ---
# Grant READ permissions only. ROBINHOOD_PRIVATE_KEY = your base64 Ed25519 private key.
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY=
ROBINHOOD_POLL_SEC=20

# Sample live feed when BROKER_DEMO=1 (seconds between fake fills)
DEMO_FEED_SEC=45
